# Conexión a Postgres (Railway la inyecta automáticamente al enlazar el servicio de base de datos)
DATABASE_URL=postgresql://suertazo:suertazo@127.0.0.1:5432/suertazo
# Pon "true" solo si te conectas por la URL pública con TLS
DATABASE_SSL=false

# Administrador ("máster") que se crea al ejecutar el seed
ADMIN_EMAIL=admin@tu-dominio.co
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administrador Suertazo
ADMIN_TELEFONO=3000000000

# URL pública de la app (se usa para los links de referido)
APP_URL=http://localhost:4817

# Notificaciones push (opcional). Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tu-dominio.co

# Link de pago de Wompi para la primera rifa (también se puede editar desde el panel del máster)
WOMPI_LINK_PAGO=

# Clave para el cron que vence reservas y envía recordatorios de cuota (POST /api/tareas)
CRON_SECRET=genera-una-clave-larga
