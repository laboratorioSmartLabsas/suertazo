{
  "name": "suertazo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4817",
    "build": "next build",
    "start": "next start -p ${PORT:-4817}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
